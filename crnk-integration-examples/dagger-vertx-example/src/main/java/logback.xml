<?xml version="1.0" encoding="UTF-8"?>
<!--docerion
type: config
title: Logback logging configuration
summary: Configures the Logback logging framework with a console appender, a formatted logging pattern, and DEBUG-level logging for the io.crnk package.
-->

<configuration>
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<charset>UTF-8</charset>
			<pattern>%d{HH:mm:ss,SSS} %-5.5p [%15.15t] [%30.30c] %X{indent}%m%n
			</pattern>
		</encoder>
	</appender>

	<logger name="io.crnk" level="DEBUG"/>

	<root level="DEBUG">
		<appender-ref ref="CONSOLE"/>
	</root>
</configuration>

